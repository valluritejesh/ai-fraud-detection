# Environment & Networking
ENVIRONMENT=development  # "development", "staging", "production"
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000

# Database Configuration
# Local SQLite: sqlite+aiosqlite:///./fraud_detection.db
# Azure PostgreSQL: postgresql+asyncpg://<username>:<password>@<server-name>.postgres.database.azure.com:5432/<dbname>?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Security
AUTH_ENABLED=false
DEV_AUTH_BYPASS=true
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Microsoft Entra ID (Azure AD) - Optional when using enterprise SSO
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=

# Evidence File Storage
# Options: "local" (default filesystem) or "azure_blob" (Azure Blob Storage)
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=25
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence-files

# Optional Azure AI Services
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# LLM Reasoning & LangGraph Orchestration
# Options: "mock" (default, zero keys required), "gemini", "openrouter"
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
