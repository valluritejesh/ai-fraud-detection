# Database (SQLite default or Azure SQL / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db

# Security
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Storage & File Uploads
MAX_UPLOAD_SIZE_MB=25

# Optional Azure AI Services (Leave empty to use built-in LOCAL DEMO / MOCK simulation)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence-files

# LLM Reasoning & LangGraph Orchestration
# Options: "mock" (default, zero keys required), "gemini", "openrouter"
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
